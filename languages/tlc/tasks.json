[
  {
    "label": "Run TLC program",
    "command": "/bin/sh",
    "args": [
      "-c",
      "'script=$(base64 -d <<END\\nEND\n) || exit 1\nexec /bin/sh -c \"$script\" sh \"$@\"\n'",
      "sh",
      "run"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": {
      "program": "/bin/sh"
    },
    "reveal": "always",
    "tags": [
      "tlc-main"
    ]
  },
  {
    "label": "Check TLC program",
    "command": "/bin/sh",
    "args": [
      "-c",
      "'script=$(base64 -d <<END\\nEND\n) || exit 1\nexec /bin/sh -c \"$script\" sh \"$@\"\n'",
      "sh",
      "check"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "shell": {
      "program": "/bin/sh"
    },
    "reveal": "always"
  },
  {
    "label": "Build TLC debug binary",
